<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 positioning="cascading"
 can_minimize="true"
 can_resize="false"
 height="206"
 layout="topleft"
 name="floater_ss_atmo_assets"
 save_rect="true"
 single_instance="true"
 title="ATMO MAGIC - GLOBAL ASSETS"
 width="440">
    <text
     follows="left|top" layout="topleft" left="12" top="26"
     height="40" width="416" word_wrap="true" font="SansSerifSmall">
        Precipitation textures and sound packs live in each preset - open the preset editor for those. Wind is not tied to a precipitation type, so it is configured here.
    </text>
    <text
     follows="left|top" layout="topleft" left="12" top_pad="10"
     height="14" width="416" name="wind_label" font="SansSerifSmallBold">
        Wind loops - comma separated sound UUIDs play as a sequence
    </text>
    <line_editor
     control_name="SSAtmoLoopWindLight"
     follows="left|top" layout="topleft" left="12" top_pad="6"
     height="20" width="416" label="Wind, light" name="loop_wind_light" />
    <line_editor
     control_name="SSAtmoLoopWindStrong"
     follows="left|top" layout="topleft" left="12" top_pad="4"
     height="20" width="416" label="Wind, strong" name="loop_wind_strong" />
</floater>
