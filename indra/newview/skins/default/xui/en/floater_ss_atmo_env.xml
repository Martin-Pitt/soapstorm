<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 positioning="cascading"
 can_minimize="true"
 can_resize="true"
 height="740"
 layout="topleft"
 min_height="600"
 min_width="760"
 name="floater_ss_atmo_env"
 save_rect="true"
 single_instance="true"
 title="Edit Atmo Magic Environment"
 width="800">
    <!-- <SS:Nexii> Atmo Magic floater. Laid out to echo
         floater_edit_ext_day_cycle.xml where the two overlap - same
         vertical position for the name row, Load/Save/Revert docked at the
         bottom the same way Save/Cancel are there, the same
         SkipBackward_Off/SkipForward_Off step icons - since anyone who
         already knows EEP's editor should feel at home here, not have to
         relearn a different convention for the same kind of job. Where v3
         actually differs (isolated per-track weather cubes, no shared
         keyframe timeline) the layout differs too rather than forcing a
         false parallel. -->

    <!-- Shown only while nothing is loaded - the one-time bootstrap
         affordance; there is no implicit default this floater falls back
         to otherwise. -->
    <text
     follows="left|top"
     layout="topleft"
     left="15"
     top="30"
     height="32"
     width="740"
     name="no_asset_text"
     wrap="true">
        Nothing is loaded yet. Create a new environment, or drag a notecard
        onto this floater to load one.
    </text>
    <button
     follows="left|top"
     layout="topleft"
     left="15"
     top_pad="6"
     height="23"
     width="200"
     name="create_new_button"
     label="Create New Environment" />

    <!-- Editing chrome - hidden until hasAsset() is true -->

    <!-- Name row - same top="5" as floater_edit_ext_day_cycle.xml's "Day
         Cycle Name:" row. -->
    <text
     follows="left|top"
     layout="topleft"
     left="15"
     top="5"
     height="14"
     width="80"
     name="name_label"
     font="SansSerifSmallBold">
        Name
    </text>
    <line_editor
     follows="left|top"
     layout="topleft"
     left_pad="10"
     top="5"
     height="21"
     width="360"
     name="name_editor" />

    <!-- Forecast - moved to the very top of the editing chrome (right under
         the name row) so it stays visible regardless of which tab is
         selected below, rather than buried inside the Weather tab it's
         summarising. Purely a display convenience, never persisted - see
         SSAtmoEnvWeatherResolver::generateForecastText(). -->
    <text
     follows="left|top"
     layout="topleft"
     left="15"
     top_pad="12"
     height="16"
     width="770"
     name="forecast_text"
     font="SansSerifSmallBold">
        -
    </text>

    <!-- Preview time - above the tab container (and thus above whatever
         "Weather" section header lives inside its tab), the same way EEP's
         timeline sits above its own sky/water tab_container. Wider than
         Edit Day Cycle's own 525px timeline slider since there's room to
         spare and a longer scrub makes fine positioning easier.

         The generous clearance above and below is load-bearing: the ghost
         keyframe overlay (drawKeyframeGhosts) renders value labels in two
         lanes ~16px above and below the scrubber's own rect, so anything
         packed tighter gets written over on hover.

         The slider is a PERCENTAGE of the cycle, which is what a phase
         actually is; the track's day length turns that into a time of day
         afterwards, in the readout beside it. It used to say max 4.0 while
         onCommitPreviewTime read the value as a phase directly, so the head
         could be dragged to four whole cycles and every stop was an eighth
         of one apart.

         refreshPreview sets the same range in code, and the increment there
         is 100/SS_ATMOENV_PREVIEW_STEPS - keep this in step with it, because
         seeded keyframes snap to that grid so they land somewhere the head
         can actually reach. -->
    <text
     follows="left|top"
     layout="topleft"
     left="15"
     top_pad="26"
     height="14"
     width="90"
     name="preview_time_caption"
     font="SansSerifSmall">
        Preview time
    </text>
    <slider
     follows="left|top"
     layout="topleft"
     left_pad="8"
     top_delta="-2"
     height="18"
     width="560"
     name="preview_time_slider"
     show_text="false"
     min_val="0.0"
     max_val="100.0"
     increment="1.0"
     initial_value="0.0" />
    <text
     follows="left|top"
     layout="topleft"
     left_pad="8"
     height="14"
     width="120"
     name="preview_time_value_text"
     font="SansSerifSmall">
        0:00 (0%)
    </text>

    <!-- Body: a vertical altitude rail on the left, same idiom as
         pnl_environment_altitudes in panel_region_environment.xml (Region/
         Estate floater's Environment tab) - a vertical multi_slider with a
         floating altitude label per track, rather than a table or a plain
         button list. Doubles as the track selector: dragging a thumb
         repositions that track's floor, and mousing one down (whether or
         not it's then dragged) selects that track for the tab_container on
         the right. Ground has no floor of its own to drag (see
         SSAtmoEnvTrack::mFloorZ) so it's a fixed row below the slider
         instead, always present, never removable. See
         doc/atmo_magic_environment.md. -->
    <panel
     follows="left|top|bottom"
     layout="topleft"
     left="15"
     top="122"
     bottom="-50"
     height="554"
     width="170"
     name="track_panel"
     background_visible="false"
     border="false">
        <text
         follows="left|top"
         layout="topleft"
         left="0"
         top="0"
         height="14"
         width="170"
         name="tracks_label"
         font="SansSerifSmallBold">
            Tracks
        </text>

        <!-- Up to SS_ATMOENV_MAX_TRACKS-1 (3) optional-track markers,
             added/removed at runtime (see refreshTrackRail()) rather than a
             fixed set - unlike EEP's always-exactly-four sky tracks, Atmo
             Magic tracks are 1-4 total, so nothing here is meaningful until
             a track exists to show. draw_track gives the vertical rail line
             from the region Environment tab this mirrors.

             The rail is anchored top and bottom so it actually fills the
             panel's height rather than collapsing to whatever a chained
             top_pad left over; increment is 64m so it divides 4096 exactly
             (dragging to the top used to land on 4100m, past the region
             ceiling) and lands cleanly on the powers of two people build
             around - 512/1024/2048 are all reachable exactly.

             overlap_threshold is not the spacing it enforces: LLMultiSlider
             stores it as (value - increment) and then compares against
             (that + increment/4), so the gap it actually enforces is
             overlap_threshold - 48 with a 64m increment. 304 is therefore
             what asks for a real 256m minimum between markers - enough
             that two 20px name buttons can't collide at this rail height.

             thumb_width is the marker's thickness along the rail, not its
             width across it, so 8 keeps the flat bar shape from the region
             Environment tab; matching it to the control's own 17px width
             made each marker square, which the rounded thumb image then
             drew as a circle. Nothing in C++ depends on this number -
             refreshAltitudeLabel() asks the control where the thumb
             actually landed rather than recomputing it. -->
        <multi_slider
         follows="left|top|bottom"
         layout="topleft"
         left="100"
         top="30"
         bottom="-129"
         height="395"
         width="17"
         name="track_altitude_slider"
         orientation="vertical"
         min_val="0"
         max_val="4096"
         increment="64"
         decimal_digits="0"
         max_sliders="7"
         overlap_threshold="304"
         show_text="false"
         draw_track="true"
         use_triangle="false"
         thumb_width="8" />

        <!-- Each marker carries a compact toggle button (the track's name,
             left of the rail) and an altitude readout (right of it), both
             repositioned in C++ to follow its thumb - see
             refreshAltitudeLabel(). The button being a toggle is the point:
             these *are* the tab selector for the panel on the right, so the
             selected one has to look pressed rather than looking like an
             inert caption. Initial top/left here are placeholders; the real
             vertical position is altitude-derived.

             One pair per optional track, so SS_ATMOENV_MAX_TRACKS - 1 of
             them. Both are the same height and vertically centred so the
             name and the altitude line up with each other and with the
             thumb between them. -->
        <button
         follows="left|top"
         layout="topleft"
         left="0"
         top="0"
         height="20"
         width="96"
         is_toggle="true"
         name="track_name_button_1"
         font="SansSerifSmall"
         label="Track 1"
         visible="false" />
        <text
         follows="left|top"
         layout="topleft"
         left="122"
         top="0"
         height="20"
         width="48"
         name="track_alt_label_1"
         font="SansSerifSmall"
         text_valign="center"
         visible="false" />
        <button
         follows="left|top"
         layout="topleft"
         left="0"
         top="0"
         height="20"
         width="96"
         is_toggle="true"
         name="track_name_button_2"
         font="SansSerifSmall"
         label="Track 2"
         visible="false" />
        <text
         follows="left|top"
         layout="topleft"
         left="122"
         top="0"
         height="20"
         width="48"
         name="track_alt_label_2"
         font="SansSerifSmall"
         text_valign="center"
         visible="false" />
        <button
         follows="left|top"
         layout="topleft"
         left="0"
         top="0"
         height="20"
         width="96"
         is_toggle="true"
         name="track_name_button_3"
         font="SansSerifSmall"
         label="Track 3"
         visible="false" />
        <text
         follows="left|top"
         layout="topleft"
         left="122"
         top="0"
         height="20"
         width="48"
         name="track_alt_label_3"
         font="SansSerifSmall"
         text_valign="center"
         visible="false" />
        <button
         follows="left|top"
         layout="topleft"
         left="0"
         top="0"
         height="20"
         width="96"
         is_toggle="true"
         name="track_name_button_4"
         font="SansSerifSmall"
         label="Track 4"
         visible="false" />
        <text
         follows="left|top"
         layout="topleft"
         left="122"
         top="0"
         height="20"
         width="48"
         name="track_alt_label_4"
         font="SansSerifSmall"
         text_valign="center"
         visible="false" />
        <button
         follows="left|top"
         layout="topleft"
         left="0"
         top="0"
         height="20"
         width="96"
         is_toggle="true"
         name="track_name_button_5"
         font="SansSerifSmall"
         label="Track 5"
         visible="false" />
        <text
         follows="left|top"
         layout="topleft"
         left="122"
         top="0"
         height="20"
         width="48"
         name="track_alt_label_5"
         font="SansSerifSmall"
         text_valign="center"
         visible="false" />
        <button
         follows="left|top"
         layout="topleft"
         left="0"
         top="0"
         height="20"
         width="96"
         is_toggle="true"
         name="track_name_button_6"
         font="SansSerifSmall"
         label="Track 6"
         visible="false" />
        <text
         follows="left|top"
         layout="topleft"
         left="122"
         top="0"
         height="20"
         width="48"
         name="track_alt_label_6"
         font="SansSerifSmall"
         text_valign="center"
         visible="false" />
        <button
         follows="left|top"
         layout="topleft"
         left="0"
         top="0"
         height="20"
         width="96"
         is_toggle="true"
         name="track_name_button_7"
         font="SansSerifSmall"
         label="Track 7"
         visible="false" />
        <text
         follows="left|top"
         layout="topleft"
         left="122"
         top="0"
         height="20"
         width="48"
         name="track_alt_label_7"
         font="SansSerifSmall"
         text_valign="center"
         visible="false" />

        <!-- Ground: the same compact toggle button and altitude readout as
             a track marker, but pinned to the rail's 0m position rather
             than draggable - it is always 0m by definition (see
             SSAtmoEnvTrack::mFloorZ). The rail deliberately runs all the
             way down to 0 so ground reads as part of the same scale as
             every other track rather than as a footnote below it; what
             stops an optional track being dragged onto ground's band is
             SS_ATMOENV_MIN_TRACK_FLOOR, enforced in
             SSFloaterAtmoEnv::onCommitAltitudeSlider(), not the rail's own
             range. Positioned in C++ alongside the markers so it lines up
             however the floater is resized. -->
        <button
         follows="left|bottom"
         layout="topleft"
         left="0"
         bottom="-76"
         height="20"
         width="96"
         is_toggle="true"
         name="track_ground_button"
         font="SansSerifSmall"
         label="Ground" />
        <text
         follows="left|bottom"
         layout="topleft"
         left="122"
         bottom="-76"
         height="20"
         width="48"
         name="track_ground_alt_label"
         font="SansSerifSmall"
         text_valign="center">
            0m
        </text>

        <!-- Bottom-docked with explicit "bottom" offsets, not top_pad
             chained after the (resizable) rail above - chaining off a
             resizable sibling was what let these overlap the Ground button
             when the floater was shrunk vertically. -->
        <button
         follows="left|bottom"
         layout="topleft"
         left="0"
         bottom="-41"
         height="23"
         width="170"
         name="add_track_button"
         tool_tip="Up to four tracks total, the ground track plus three optional"
         label="Add Track" />
        <button
         follows="left|bottom"
         layout="topleft"
         left="0"
         bottom="-14"
         height="23"
         width="170"
         name="remove_track_button"
         tool_tip="Select a track above first; the ground track cannot be removed"
         label="Remove Track" />
    </panel>

    <tab_container
     follows="all"
     layout="topleft"
     left="199"
     top="122"
     bottom="-50"
     width="586"
     halign="left"
     tab_position="top"
     tab_width="90"
     tab_padding_right="2"
     name="atmo_tabs">
        <!-- Tab order is altitude order, bottom to top, matching the rail
             beside it: the track's own foundation, then water at sea level,
             surface weather above that, the cloud deck, the sky itself, and
             the celestial bodies at the top. -->
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="track_tab"
         label="Track"
         filename="panel_ss_atmo_env_track.xml" />
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="water_tab"
         label="Water"
         filename="panel_ss_atmo_env_water.xml" />
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="weather_tab"
         label="Weather"
         filename="panel_ss_atmo_env_weather.xml" />
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="clouds_tab"
         label="Clouds"
         filename="panel_ss_atmo_env_clouds.xml" />
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="atmosphere_tab"
         label="Atmosphere"
         filename="panel_ss_atmo_env_atmosphere.xml" />
        <panel
         border="true"
         layout="topleft"
         left_delta="0"
         top_pad="5"
         name="planetary_tab"
         label="Planetary"
         filename="panel_ss_atmo_env_planetary.xml" />
    </tab_container>

    <!-- CRUD row, docked at the floater's bottom edge, same as Save/Cancel
         on floater_edit_ext_day_cycle.xml. Save writes immediately using
         the Name field above (no "As" dialog - there's nothing to pick,
         the name is already right there); Load opens inventory and reveals
         the "Atmo Magic" settings subfolder rather than filtering the whole
         panel. -->
    <button
     follows="left|bottom"
     layout="topleft"
     left="15"
     bottom="-14"
     height="23"
     width="100"
     name="load_button"
     tool_tip="Opens inventory to the Atmo Magic folder - drag a notecard onto this floater to load it, or drop a full-perm EEP sky to stamp its look at the current preview time"
     label="Load..." />
    <button
     follows="left|bottom"
     layout="topleft"
     left_pad="8"
     bottom_delta="0"
     height="23"
     width="100"
     name="save_button"
     tool_tip="Saves the current environment - updates the notecard already loaded in place, or creates a new one if nothing owned is loaded yet"
     label="Save" />
    <button
     follows="left|bottom"
     layout="topleft"
     left_pad="8"
     bottom_delta="0"
     height="23"
     width="100"
     name="revert_button"
     tool_tip="Discards edits, back to whatever was last loaded or saved"
     label="Revert" />

    <!-- <SS:Nexii> Unload, beside Revert and deliberately distinct from it:
         Revert restores the last saved state of THIS environment, Unload
         leaves nothing loaded at all, so the world falls back to whatever
         EEP's parcel or region setting publishes. -->
    <button
     follows="left|bottom"
     layout="topleft"
     left_pad="8"
     bottom_delta="0"
     height="23"
     width="100"
     name="unload_button"
     tool_tip="Drop this environment and fall back to the parcel or region EEP setting. Does not delete the notecard"
     label="Unload" />
</floater>
