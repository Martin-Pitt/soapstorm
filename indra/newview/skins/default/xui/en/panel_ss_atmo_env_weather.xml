     follows="left|top"
     layout="topleft"
     left_pad="6"
     top_delta="-2"
     height="18"
     width="280"
     name="moisture_slider"
     show_text="false"
     min_val="0"
     max_val="1"
     increment="0.001"
     initial_value="0" />
    <spinner
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top_delta="-1"
     height="20"
     width="70"
     label_width="0"
     name="moisture_value_spinner"
     min_val="0"
     max_val="1"
     increment="0.001"
     decimal_digits="2" />
    <button
     follows="left|top"
     layout="topleft"
     left_pad="4"
     top_delta="-3"
     height="25"
     width="25"
     name="moisture_prev_button"
     tool_tip="Jump to the previous keyframe"
     image_overlay="SkipBackward_Off"
     image_disabled="PushButton_Disabled"
     image_disabled_selected="PushButton_Disabled"
     image_selected="PushButton_Selected"
     image_unselected="PushButton_Off"
     hover_glow_amount="0.15"
     label="" />
    <button
     follows="left|top"
     layout="topleft"
