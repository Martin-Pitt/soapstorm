<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- <SS:Nexii> Combat Log Reconstruction transport (doc/combat_log_ux.md 3.10). Stock widgets only, docked
     top-centre by sscombatreconstruct.cpp, just below the menu/top bar, never the legend's territory at the
     bottom, because selecting any event now opens this panel directly (ux rework 2026-09-09). The play/pause
     button is the same icon-overlay idiom as the Atmo Magic environment editor's preview_play_button. The
     scrub slider is a 0..100 fraction of the death window and nothing else, so a scrub cannot wander into the
     rest of the session; the readout stays relative to the event ("-2.40 s"). The root panel's own class is a
     tiny SSCombatReconPanel subclass (sscombatreconstruct.cpp) that draws a tick + small icon on the slider
     track marking the event's own instant, the readout's "0 s" reference. -->
<panel
 name="panel_ss_combat_reconstruct"
 class="ss_combat_recon_panel"
 follows="top"
 layout="topleft"
 background_visible="true"
 mouse_opaque="true"
 visible="false"
 left="0"
 top="0"
 height="44"
 width="420">
    <button
     name="play_btn"
     follows="left|top"
     layout="topleft"
     left="8"
     top="4"
     height="22"
     width="22"
     tool_tip="Play or pause the replay (Space)"
     image_overlay="Play_Off"
     image_disabled="PushButton_Disabled"
     image_disabled_selected="PushButton_Disabled"
     image_selected="PushButton_Selected"
     image_unselected="PushButton_Off"
     hover_glow_amount="0.15"
     label="" />
    <slider
     name="scrub_slider"
     follows="left|top"
     layout="topleft"
     left_pad="8"
     top="10"
     height="14"
     width="226"
     min_val="0"
     max_val="100"
     increment="0.1"
     show_text="false"
     tool_tip="Scrub the event window" />
    <text
     name="time_readout"
     follows="left|top"
     layout="topleft"
     left_pad="8"
     top="10"
     height="16"
     width="62"
     font="SansSerifSmall"
     tool_tip="Time relative to the event">
        +0.00 s
    </text>
    <check_box
     name="loop_check"
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top="8"
     height="16"
     width="46"
     label="Loop"
     tool_tip="Restart at the beginning of the window when the replay reaches the end" />
    <button
     name="close_btn"
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top="4"
     height="20"
     width="20"
     label="X"
     tool_tip="Leave the reconstruction and clear the selection (Esc)" />
</panel>
