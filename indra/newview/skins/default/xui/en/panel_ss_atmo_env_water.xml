<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="all"
 label="Water"
 layout="topleft"
 left="0"
 name="panel_ss_atmo_env_water"
 top="0"
 width="580"
 height="540">
    <!-- <SS:Nexii> Atmo Magic: this track water plane. The parameter set
         mirrors EEP own Water panel (panel_settings_water.xml) one-for-one,
         the difference being that every one of them is keyframable.

         Same row grid as the Weather tab. The colour swatch and texture
         picker keep their usual proportions rather than being stretched to
         slider width - they are pickers, not scales, and a 280px swatch
         says nothing a 60px one does not. The wave vectors take two rows
         each: the graphic needs squarish proportions to be usable, so it
         sits on the right spanning both rows while X and Y sit on the left
         in the same spinner column as every other row. Their own built-in
         entry bar is collapsed (edit_bar_height 0) for that reason. -->
    <check_box
     follows="left|top"
     layout="topleft"
     left="10"
     top="10"
     height="16"
     width="360"
     name="water_enabled_check"
     label="This track has a water plane"
     tool_tip="Only the lowest enabled track water is ever the one globally visible plane, regardless of which track the avatar is in" />

    <text
     follows="left|top"
     layout="topleft"
     left="10"
     top_pad="10"
     height="14"
     width="110"
     name="water_height_label"
     font="SansSerifSmall">
        Height (m)
    </text>
    <slider
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top_delta="-2"
     height="18"
     width="280"
     name="water_height_slider"
     show_text="false"
     min_val="0"
     max_val="100"
     increment="1"
     initial_val="0" />
    <spinner
     follows="left|top"
