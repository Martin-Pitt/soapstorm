integer combatLogListener;

ReportRegionSettings() {
    llOwnerSay("C2RS|" + llList2Json(JSON_OBJECT, [
        "flags", llGetRegionFlags(), // Only relevant for REGION_FLAG_ALLOW_DIRECT_TELEPORT really
        "allow_damage_adjust", llGetEnv("allow_damage_adjust"),
        "restrict_combat_log", llGetEnv("restrict_combat_log"),
        "damage_throttle", llGetEnv("damage_throttle"),
        "damage_limit", llGetEnv("damage_limit"),
        "restore_health", llGetEnv("restore_health"),
        "health_regen_rate", llGetEnv("health_regen_rate"),
        "invulnerability_time", llGetEnv("invulnerability_time"),
        "death_action", llGetEnv("death_action"),
        "agent_limit", llGetEnv("agent_limit")
    ]));
}


default
{
    listen(integer channel, string name, key identifier, string text)
    {
        // Pass through combat log messages from the simulator
        if(identifier == COMBAT_LOG_ID) llOwnerSay("C2" + llGetEnv("frame_number") + "|" + text);
        
        // Scripted combat log messages from other sources than the simulator
        else
        {
            key owner = llGetOwnerKey(identifier);
            llOwnerSay("C2" + llGetEnv("frame_number") + "|" + (string)identifier + (string)owner + text);
        }
    }
    
    final_damage(integer count)
    {
        string source0; list sourceDetails0;
        string rezzer0; list rezzerDetails0;
        string root0; list rootDetails0;
        
        string source1; list sourceDetails1;
        string rezzer1; list rezzerDetails1;
        string root1; list rootDetails1;
        
        string source2; list sourceDetails2;
        string rezzer2; list rezzerDetails2;
        string root2; list rootDetails2;
        
        string source3; list sourceDetails3;
        string rezzer3; list rezzerDetails3;
        string root3; list rootDetails3;
        
        string source4; list sourceDetails4;
        string rezzer4; list rezzerDetails4;
        string root4; list rootDetails4;
        
        string source5; list sourceDetails5;
        string rezzer5; list rezzerDetails5;
        string root5; list rootDetails5;
        
        string source6; list sourceDetails6;
        string rezzer6; list rezzerDetails6;
        string root6; list rootDetails6;
        
        string source7; list sourceDetails7;
        string rezzer7; list rezzerDetails7;
        string root7; list rootDetails7;
        
        string source8; list sourceDetails8;
        string rezzer8; list rezzerDetails8;
        string root8; list rootDetails8;
        
        float time = llGetTime();
        vector targetPos = llGetPos();
        rotation targetRot = llGetRot();
        vector targetVel = llGetVel();
        
        integer index;
        for(index = 0; index < count; ++index)
        {
            if(index == 0)
            {
                source0 = llDetectedKey(index);
                if(source0) sourceDetails0 = llGetObjectDetails(source0, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                rezzer0 = llDetectedRezzer(index);
                if(rezzer0)
                {
                    rezzerDetails0 = llGetObjectDetails(rezzer0, [OBJECT_REZZER_KEY, OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                    root0 = llList2String(rezzerDetails0, 0);
                    if(root0) rootDetails0 = llGetObjectDetails(root0, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                }
            }
            else if(index == 1)
            {
                source1 = llDetectedKey(index);
                if(source1) sourceDetails1 = llGetObjectDetails(source1, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                rezzer1 = llDetectedRezzer(index);
                if(rezzer1)
                {
                    rezzerDetails1 = llGetObjectDetails(rezzer1, [OBJECT_REZZER_KEY, OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                    root1 = llList2String(rezzerDetails1, 0);
                    if(root1) rootDetails1 = llGetObjectDetails(root1, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                }
            }
            else if(index == 2)
            {
                source2 = llDetectedKey(index);
                if(source2) sourceDetails2 = llGetObjectDetails(source2, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                rezzer2 = llDetectedRezzer(index);
                if(rezzer2)
                {
                    rezzerDetails2 = llGetObjectDetails(rezzer2, [OBJECT_REZZER_KEY, OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                    root2 = llList2String(rezzerDetails2, 0);
                    if(root2) rootDetails2 = llGetObjectDetails(root2, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                }
            }
            else if(index == 3)
            {
                source3 = llDetectedKey(index);
                if(source3) sourceDetails3 = llGetObjectDetails(source3, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                rezzer3 = llDetectedRezzer(index);
                if(rezzer3)
                {
                    rezzerDetails3 = llGetObjectDetails(rezzer3, [OBJECT_REZZER_KEY, OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                    root3 = llList2String(rezzerDetails3, 0);
                    if(root3) rootDetails3 = llGetObjectDetails(root3, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                }
            }
            else if(index == 4)
            {
                source4 = llDetectedKey(index);
                if(source4) sourceDetails4 = llGetObjectDetails(source4, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                rezzer4 = llDetectedRezzer(index);
                if(rezzer4)
                {
                    rezzerDetails4 = llGetObjectDetails(rezzer4, [OBJECT_REZZER_KEY, OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                    root4 = llList2String(rezzerDetails4, 0);
                    if(root4) rootDetails4 = llGetObjectDetails(root4, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                }
            }
            else if(index == 5)
            {
                source5 = llDetectedKey(index);
                if(source5) sourceDetails5 = llGetObjectDetails(source5, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                rezzer5 = llDetectedRezzer(index);
                if(rezzer5)
                {
                    rezzerDetails5 = llGetObjectDetails(rezzer5, [OBJECT_REZZER_KEY, OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                    root5 = llList2String(rezzerDetails5, 0);
                    if(root5) rootDetails5 = llGetObjectDetails(root5, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                }
            }
            else if(index == 6)
            {
                source6 = llDetectedKey(index);
                if(source6) sourceDetails6 = llGetObjectDetails(source6, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                rezzer6 = llDetectedRezzer(index);
                if(rezzer6)
                {
                    rezzerDetails6 = llGetObjectDetails(rezzer6, [OBJECT_REZZER_KEY, OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                    root6 = llList2String(rezzerDetails6, 0);
                    if(root6) rootDetails6 = llGetObjectDetails(root6, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                }
            }
            else if(index == 7)
            {
                source7 = llDetectedKey(index);
                if(source7) sourceDetails7 = llGetObjectDetails(source7, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                rezzer7 = llDetectedRezzer(index);
                if(rezzer7)
                {
                    rezzerDetails7 = llGetObjectDetails(rezzer7, [OBJECT_REZZER_KEY, OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                    root7 = llList2String(rezzerDetails7, 0);
                    if(root7) rootDetails7 = llGetObjectDetails(root7, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                }
            }
            else if(index == 8)
            {
                source8 = llDetectedKey(index);
                if(source8) sourceDetails8 = llGetObjectDetails(source8, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                rezzer8 = llDetectedRezzer(index);
                if(rezzer8)
                {
                    rezzerDetails8 = llGetObjectDetails(rezzer8, [OBJECT_REZZER_KEY, OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                    root8 = llList2String(rezzerDetails8, 0);
                    if(root8) rootDetails8 = llGetObjectDetails(root8, [OBJECT_NAME, OBJECT_POS, OBJECT_ATTACHED_POINT, OBJECT_GROUP, OBJECT_CREATOR]);
                }
            }
        }
        
        for(index = 0; index < count; ++index)
        {
            list damage = llDetectedDamage(index);
            float delivered = llList2Float(damage, 0);
            integer type = llList2Integer(damage, 1);
            float original = llList2Float(damage, 2);
            string owner = llDetectedOwner(index);
            
            string source; list sourceDetails;
            string rezzer; list rezzerDetails;
            string root; list rootDetails;
            
            if(index == 0) { source = source0; sourceDetails = sourceDetails0; rezzer = rezzer0; rezzerDetails = rezzerDetails0; root = root0; rootDetails = rootDetails0; }
            else if(index == 1) { source = source1; sourceDetails = sourceDetails1; rezzer = rezzer1; rezzerDetails = rezzerDetails1; root = root1; rootDetails = rootDetails1; }
            else if(index == 2) { source = source2; sourceDetails = sourceDetails2; rezzer = rezzer2; rezzerDetails = rezzerDetails2; root = root2; rootDetails = rootDetails2; }
            else if(index == 3) { source = source3; sourceDetails = sourceDetails3; rezzer = rezzer3; rezzerDetails = rezzerDetails3; root = root3; rootDetails = rootDetails3; }
            else if(index == 4) { source = source4; sourceDetails = sourceDetails4; rezzer = rezzer4; rezzerDetails = rezzerDetails4; root = root4; rootDetails = rootDetails4; }
            else if(index == 5) { source = source5; sourceDetails = sourceDetails5; rezzer = rezzer5; rezzerDetails = rezzerDetails5; root = root5; rootDetails = rootDetails5; }
            else if(index == 6) { source = source6; sourceDetails = sourceDetails6; rezzer = rezzer6; rezzerDetails = rezzerDetails6; root = root6; rootDetails = rootDetails6; }
            else if(index == 7) { source = source7; sourceDetails = sourceDetails7; rezzer = rezzer7; rezzerDetails = rezzerDetails7; root = root7; rootDetails = rootDetails7; }
            else if(index == 8) { source = source8; sourceDetails = sourceDetails8; rezzer = rezzer8; rezzerDetails = rezzerDetails8; root = root8; rootDetails = rootDetails8; }
            
            // Note unlike combat log the typecasting of vectors and rotations like <#, #, #> etc
            llOwnerSay("C2" + llGetEnv("frame_number") + "|" + llList2Json(JSON_OBJECT, [
                "event", "FINAL_DAMAGE",
                
                "source", source, "sourceDetails", llList2Json(JSON_ARRAY, sourceDetails),
                "rezzer", rezzer, "rezzerDetails", llList2Json(JSON_ARRAY, rezzerDetails),
                "root", root, "rootDetails", llList2Json(JSON_ARRAY, rootDetails),
                "owner", owner,
                
                "damage", delivered,
                "type", type,
                "original", original,
                
                "targetPos", targetPos,
                "targetRot", targetRot,
                "targetVel", targetVel
            ]));
        }
    }
    
