<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 positioning="cascading"
 can_minimize="true"
 can_resize="false"
 height="490"
 layout="topleft"
 name="floater_ss_atmo_v3"
 save_rect="true"
 single_instance="true"
 title="ATMO MAGIC v3"
 width="360">
    <!-- <SS:Nexii> Atmo Magic v3 floater: phase 1 - create/load/save/revert
         and a bare track list only. No per-tab editing (Atmosphere &
         Lighting / Clouds / Planetary / Weather) yet - see
         doc/atmo_magic_v3_environment.md for what those phases add. -->
    <text
     follows="left|top"
     layout="topleft"
     left="12"
     top="26"
     height="14"
     width="336"
     name="status_text"
     font="SansSerifSmall">
        no environment loaded
    </text>

    <!-- Shown only while nothing is loaded - the one-time bootstrap
         affordance; there is no implicit default this floater falls back
         to otherwise. -->
    <text
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="40"
     height="32"
     width="336"
     name="no_asset_text"
     wrap="true">
        Nothing is loaded yet. Create a new environment, or drag a notecard
        onto this floater to load one.
    </text>
    <button
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="10"
     height="23"
     width="200"
     name="create_new_button"
     label="Create New Environment" />

    <!-- Editing chrome - hidden until hasAsset() is true -->
    <text
     follows="left|top"
     layout="topleft"
     left="12"
     top="66"
     height="14"
     width="60"
     name="name_label"
     font="SansSerifSmallBold">
        Name
    </text>
    <line_editor
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top_delta="-2"
     height="20"
     width="270"
     name="name_editor" />

    <text
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="10"
     height="14"
     width="200"
     name="tracks_label"
     font="SansSerifSmallBold">
        Tracks
    </text>
    <scroll_list
     column_padding="0"
     draw_heading="true"
     follows="left|top"
     height="140"
     layout="topleft"
     left="12"
     top_pad="6"
     width="336"
     name="track_list">
        <scroll_list.columns
         label="Track"
         name="name"
         width="180" />
        <scroll_list.columns
         label="Altitude band"
         name="range"
         width="150" />
    </scroll_list>

    <button
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="6"
     height="23"
     width="162"
     name="add_track_button"
     tool_tip="Up to four tracks total, the ground track plus three optional"
     label="Add Track" />
    <button
     follows="left|top"
     layout="topleft"
     left_pad="12"
     height="23"
     width="162"
     name="remove_track_button"
     tool_tip="Select a track above first; the ground track cannot be removed"
     label="Remove Track" />

    <!-- Phase 3 keyframe engine proof: ground track's Moisture field only.
         Not the real Weather tab - just enough surface to exercise
         ssatmov3keyframe.h's editing rule (see ssfloateratmov3.cpp). -->
    <text
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="10"
     height="14"
     width="336"
     name="keyframe_proof_label"
     font="SansSerifSmallBold">
        Keyframe engine proof (ground track: Moisture)
    </text>
    <text
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="6"
     height="14"
     width="100"
     name="preview_time_label"
     font="SansSerifSmall">
        Preview time
    </text>
    <slider
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top_delta="-2"
     height="18"
     width="230"
     name="preview_time_slider"
     min_val="0.0"
     max_val="1.0"
     initial_val="0.0" />

    <text
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="10"
     height="14"
     width="100"
     name="moisture_label"
     font="SansSerifSmall">
        Moisture
    </text>
    <slider
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top_delta="-2"
     height="18"
     width="150"
     name="moisture_slider"
     min_val="0.0"
     max_val="1.0"
     initial_val="0.0" />
    <button
     follows="left|top"
     layout="topleft"
     left_pad="4"
     top_delta="-3"
     height="23"
     width="23"
     name="moisture_keyframe_button"
     tool_tip="Add or remove a keyframe at the current preview time"
     label="&#9671;" />
    <button
     follows="left|top"
     layout="topleft"
     left_pad="2"
     height="23"
     width="23"
     name="moisture_prev_button"
     tool_tip="Jump to the previous keyframe"
     label="&lt;" />
    <button
     follows="left|top"
     layout="topleft"
     left_pad="2"
     height="23"
     width="23"
     name="moisture_next_button"
     tool_tip="Jump to the next keyframe"
     label="&gt;" />
    <text
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="4"
     height="14"
     width="200"
     name="moisture_keyframe_count_text"
     font="SansSerifSmall">
        0 keyframe(s)
    </text>

    <!-- Phase 5 proof: SSAtmoV3WeatherResolver::resolve() output at the
         current preview time, e.g. "Thundery showers and a gentle breeze". -->
    <text
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="10"
     height="14"
     width="336"
     name="forecast_text"
     font="SansSerifSmallBold">
        -
    </text>

    <button
     follows="left|bottom"
     layout="topleft"
     left="12"
     bottom="12"
     height="23"
     width="80"
     name="load_button"
     label="Load..." />
    <button
     follows="left|bottom"
     layout="topleft"
     left_pad="6"
     height="23"
     width="80"
     name="save_button"
     label="Save As..." />
    <button
     follows="left|bottom"
     layout="topleft"
     left_pad="6"
     height="23"
     width="80"
     name="revert_button"
     label="Revert" />
</floater>
