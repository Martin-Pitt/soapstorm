<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 positioning="cascading"
 can_minimize="false"
 can_resize="false"
 height="470"
 layout="topleft"
 name="floater_ss_atmo_env_create"
 single_instance="true"
 title="Create Atmo Environment"
 width="470">
    <!-- <SS:Nexii> What "Create New Environment" means is a choice, so the button opens this
         chooser rather than acting. Four seeds, one per radio item: the midday defaults, the
         stock four-sky day cycle, a list of skies the author picks (run through the same
         measure-and-stamp seeding the stock cycle uses), and an EEP day cycle mapped over at
         its own keyframe times. Two of the four need pickers, which is why this is a floater
         with embedded inventory panels rather than a popup menu - the whole decision, source
         and pick together, stays in one place. The panels are the same widget twice; the
         sky-vs-day-cycle difference is a settings-type filter set in code. Only full-permission
         settings can be imported, the same rule a sky dropped onto the editor obeys. -->

    <radio_group
     follows="left|top"
     height="100"
     layout="topleft"
     left="15"
     name="mode_radio"
     top="20"
     width="440">
        <radio_item
         label="Empty - midday defaults"
         layout="topleft"
         left="0"
         name="mode_empty"
         top="0" />
        <radio_item
         label="Stock day cycle (shipped Daylight, Night, Sunrise, Sunset)"
         layout="topleft"
         left="0"
         name="mode_stock"
         top_delta="24" />
        <radio_item
         label="From skies I choose:"
         layout="topleft"
         left="0"
         name="mode_skies"
         top_delta="24" />
        <radio_item
         label="From an EEP day cycle:"
         layout="topleft"
         left="0"
         name="mode_daycycle"
         top_delta="24" />
    </radio_group>

    <!-- Shown only while "From skies I choose" is picked. -->
    <asset_filtered_inv_panel
     allow_multi_select="true"
     allow_drag="false"
     accepts_drag_and_drop="false"
     bg_alpha_color="DkGray2"
     bg_visible="true"
     border="true"
     filter_asset_types="settings"
     follows="left|top"
     height="230"
     layout="topleft"
     left="15"
     name="skies_panel"
     top="132"
     width="440" />

    <!-- Shown only while "From an EEP day cycle" is picked. Same rect, so the swap is
         position-neutral. -->
    <asset_filtered_inv_panel
     allow_multi_select="false"
     allow_drag="false"
     accepts_drag_and_drop="false"
     bg_alpha_color="DkGray2"
     bg_visible="true"
     border="true"
     filter_asset_types="settings"
     follows="left|top"
     height="230"
     layout="topleft"
     left="15"
     name="daycycle_panel"
     top="132"
     width="440" />

    <text
     follows="left|top"
     height="34"
     layout="topleft"
     left="15"
     name="hint_text"
     top="368"
     width="440"
     wrap="true">
        -
    </text>

    <button
     follows="left|top"
     height="23"
     label="Create"
     layout="topleft"
     left="15"
     name="create_button"
     top="410"
     width="120" />
    <button
     follows="left|top"
     height="23"
     label="Cancel"
     layout="topleft"
     left_pad="10"
     name="cancel_button"
     top="410"
     width="120" />
</floater>
