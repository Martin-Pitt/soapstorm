<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="all"
 label="Water"
 layout="topleft"
 left="0"
 name="panel_ss_atmo_env_water"
 top="0"
 width="580"
 height="580">
    <!-- <SS:Nexii> Atmo Magic: this track water plane. The parameter set mirrors EEP own Water panel (panel_settings_water.xml) one-for-one, the difference being that every one of them is keyframable. Same row grid as the Weather tab. The colour swatch and texture picker keep their usual proportions rather than being stretched to slider width - they are pickers, not scales, and a 280px swatch says nothing a 60px one does not. The wave vectors take two rows each: the graphic needs squarish proportions to be usable, so it sits on the right spanning both rows while X and Y sit on the left in the same spinner column as every other row. Their own built-in entry bar is collapsed (edit_bar_height 0) for that reason. -->
    <check_box
     follows="left|top"
     layout="topleft"
     left="10"
     top="10"
     height="16"
     width="360"
     name="water_enabled_check"
     label="This track has a water plane"
     tool_tip="Only the lowest enabled track water is ever the one globally visible plane, regardless of which track the avatar is in" />

    <text
     follows="left|top"
     layout="topleft"
     left="10"
     top_pad="10"
     height="14"
     width="110"
     name="water_height_label"
     font="SansSerifSmall">
        Height (m)
    </text>
    <slider
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top_delta="-2"
     height="18"
     width="280"
     name="water_height_slider"
     show_text="false"
     min_val="-50"
     max_val="200"
     increment="0.01"
     initial_value="0"
     tool_tip="Near-surface dial; the spinner takes the full -10 km to +10 km range by hand" />
    <spinner
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top_delta="-1"
     height="20"
     width="70"
     label_width="0"
     name="water_height_value_spinner"
     min_val="-10000"
     max_val="10000"
     increment="0.01"
     decimal_digits="2"
     tool_tip="Ocean surface height in metres; type anything from -10 km to +10 km, so a sky build can put the ocean far below" />
    <button
     follows="left|top"
     layout="topleft"
     left_pad="4"
     top_delta="-3"
     height="25"
     width="25"
     name="water_height_prev_button"
     tool_tip="Jump to the previous keyframe"
     image_overlay="SkipBackward_Off"
     image_disabled="PushButton_Disabled"
     image_disabled_selected="PushButton_Disabled"
     image_selected="PushButton_Selected"
     image_unselected="PushButton_Off"
     hover_glow_amount="0.15"
     label="" />
    <button
     follows="left|top"
     layout="topleft"
     left_pad="2"
     height="25"
     width="25"
     name="water_height_keyframe_button"
     tool_tip="Add or remove a keyframe at the current preview time"
     label="&#9671;" />
    <button
