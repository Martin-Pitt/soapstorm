<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="all"
 label="Weather"
 layout="topleft"
 left="0"
 name="panel_ss_atmo_env_weather"
 top="0"
 width="580"
 height="540">
    <!-- <SS:Nexii> Atmo Magic: the moisture/convection/temperature cube,
         AE-style keyframe rows - see ssatmoenvkeyframe.h and the FloatRow
         comment in ssfloateratmoenv.h.

         Units live in the parameter label rather than glued to the number.
         That is what lets every tab share one right-aligned spinner column
         instead of each number drifting by the width of its own suffix. -->

    <text
     follows="left|top"
     layout="topleft"
     left="10"
     top="10"
     height="14"
     width="110"
     name="moisture_label"
     font="SansSerifSmall">
        Moisture
    </text>
    <slider
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top_delta="-2"
     height="18"
     width="280"
     name="moisture_slider"
     show_text="false"
     min_val="0"
     max_val="1"
     increment="0.001"
     initial_val="0" />
    <spinner
     follows="left|top"
     layout="topleft"
     left_pad="6"
     top_delta="-1"
     height="20"
     width="70"
     label_width="0"
     name="moisture_value_spinner"
     min_val="0"
     max_val="1"
     increment="0.001"
     decimal_digits="2" />
    <button
     follows="left|top"
     layout="topleft"
     left_pad="4"
     top_delta="-3"
     height="25"
     width="25"
     name="moisture_prev_button"
     tool_tip="Jump to the previous keyframe"
     image_overlay="SkipBackward_Off"
     image_disabled="PushButton_Disabled"
     image_disabled_selected="PushButton_Disabled"
     image_selected="PushButton_Selected"
     image_unselected="PushButton_Off"
     hover_glow_amount="0.15"
     label="" />
    <button
     follows="left|top"
     layout="topleft"
     left_pad="2"
     height="25"
     width="25"
     name="moisture_keyframe_button"
     tool_tip="Add or remove a keyframe at the current preview time"
     label="&#9671;" />
    <button
     follows="left|top"
     layout="topleft"
     left_pad="2"
     height="25"
     width="25"
     name="moisture_next_button"
     tool_tip="Jump to the next keyframe"
     image_overlay="SkipForward_Off"
     image_disabled="PushButton_Disabled"
     image_disabled_selected="PushButton_Disabled"
     image_selected="PushButton_Selected"
     image_unselected="PushButton_Off"
     hover_glow_amount="0.15"
     label="" />

